{
  "name": "drupal/actstream_mod",
  "description": "Adds moderation (approve/disapprove) to Activity Stream (actstream) entities.",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.drupal.org/project/activitystream_mod",
  "authors": [
    {
      "name": "Reva Gomes",
      "homepage": "https://www.drupal.org/u/revagomes",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://www.drupal.org/project/issues/activitystream_mod",
    "source": "https://git.drupal.org/project/activitystream_mod.git"
  },
  "require": {
    "php": "^8.1",
    "drupal/core": "^10.3 || ^11",
    "drupal/actstream": "2.0.x-dev"
  },
  "require-dev": {
    "drupal/coder": "^8.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    {
      "type": "vcs",
      "url": "https://github.com/revagomes/drupal-actstream"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
